{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AWS": {
    "Region": "us-east-1",
    "Profile": "default",
    "Cognito": {
      "UserPoolId": "YOUR_USER_POOL_ID",
      "ClientId": "YOUR_CLIENT_ID"
    },
    "S3": {
      "BucketName": "YOUR_S3_BUCKET_NAME"
    },
    "Lex": {
      "BotId": "YOUR_BOT_ID",
      "BotAliasId": "YOUR_BOT_ALIAS_ID"
    }
  }
}
