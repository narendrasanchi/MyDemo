# Use the official .NET 8 SDK image for building
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copy csproj files and restore dependencies
COPY ["Source/API/WebAPI/WebAPI.csproj", "Source/API/WebAPI/"]
COPY ["AWSDemo/AWSDemo.csproj", "AWSDemo/"]
COPY ["Common/Common.csproj", "Common/"]
COPY ["Source/API/DesignPatternsDemo/DesignPatternsDemo.csproj", "Source/API/DesignPatternsDemo/"]

RUN dotnet restore "Source/API/WebAPI/WebAPI.csproj"

# Copy the entire source code
COPY . .

# Build the application
WORKDIR "/app/Source/API/WebAPI"
RUN dotnet build "WebAPI.csproj" -c Release -o /app/build

# Publish the application
FROM build AS publish
RUN dotnet publish "WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Use the official .NET 8 runtime image for running the app
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Expose the port the app runs on
EXPOSE 8080
EXPOSE 8081

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "WebAPI.dll"]